<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>YAKG</vendor>
  <vendor_url>https://github.com/alirezaazadbakht/yakg</vendor_url>
  <action id="io.github.yakg.Yakg.manage-config">
    <description>Manage the Kerio VPN configuration</description>
    <description xml:lang="en">Manage the Kerio VPN configuration</description>
    <message>Authentication is required to read or change the Kerio VPN configuration</message>
    <message xml:lang="en">Authentication is required to read or change the Kerio VPN configuration</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/yakg-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
